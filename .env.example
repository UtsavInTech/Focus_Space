# FocusSpace API — local development.
# Copy to .env and fill in. `.env` is gitignored and is read automatically by
# `npm run ai-api` (node --env-file-if-exists).

# Required. The one key the whole product runs on — it lives only in this
# process, never in the extension or the website.
OPENAI_API_KEY=

# Optional. Any model the OpenAI API serves; this is the cheap default.
OPENAI_MODEL=gpt-4o-mini

# Required for accounts (/v1/auth/*). Generate with:
#   openssl rand -base64 32
AUTH_TOKEN_SECRET=

# Local only. Prints email/SMS verification codes instead of sending them, and
# returns them to the client so you can sign up without a mail provider.
# The server refuses to start with this set in production.
AUTH_DEV_CODES=1

PORT=8788
HOST=127.0.0.1

# ── Google sign-in (optional) ────────────────────────────────────────────────
# An OAuth 2.0 "Web application" client from the Google Cloud console. The secret
# stays in this process: the extension and the website never see it, never hold a
# client id of their own, and never talk to Google directly (server/auth/google.ts).
# Leave these unset and Google sign-in is simply unavailable — every other way in
# is unaffected.
#
# The redirect URI must be registered on the Google client *exactly* as written here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.focusspace.xyz/v1/auth/google/callback

# Where a finished Google sign-in may send the browser back to — an allow-list, so the
# callback can never be turned into an open redirect. Comma-separated origins.
WEB_ORIGINS=https://focusspace.xyz,http://localhost:5174

# Reading active-user and retention numbers (GET /v1/admin/metrics, `npm run metrics`): a long random string.
ADMIN_TOKEN=
