node_modules/
# Leading slashes matter: an unanchored "dist/" or "data/" matches a directory of
# that name at ANY depth. "data/" silently excluded all of src/content/data/ —
# seven real source files — from the repository, so a fresh clone could not build.
/dist/
/dist-server/
/dist-web/
/e2e-artifacts/
*.log
.DS_Store
# Layer 2B: local SQLite identity DB (server/auth/db.ts, DB_PATH) — dev data, never committed.
/data/
*.sqlite
*.sqlite-*
.env
/release/

# Private: business plans, sales material and agent hand-offs. Kept locally, never pushed.
/pitch/
/docs/prompts/
/docs/INSTITUTES.md
/docs/PROGRESS.md
/docs/INSTITUTE_DISCLOSURE_DRAFT.md
/web/WEBSITE_REVIEW.md
# Unused experiments
/web/src/components/FinaleArcher.tsx
/web/src/components/PageFracture.tsx
