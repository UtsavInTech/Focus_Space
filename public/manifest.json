{
  "manifest_version": 3,
  "name": "FocusSpace — Intent-Driven Learning for YouTube",
  "short_name": "FocusSpace",
  "version": "0.6.0",
  "description": "Tell FocusSpace what you're learning. It structures YouTube around that intention and hides the attention traps.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FocusSpace",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "dashboard.html#/settings",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://focusspace.xyz/*",
    "https://*.focusspace.xyz/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://focusspace.xyz/*",
        "https://*.focusspace.xyz/*",
        "https://focusspace-web-production.up.railway.app/*",
        "http://localhost:5174/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-focus": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Turn Focus Mode on or off"
    }
  },
  "minimum_chrome_version": "111",
  "externally_connectable": {
    "matches": [
      "https://focusspace.xyz/*",
      "https://*.focusspace.xyz/*",
      "https://focusspace-web-production.up.railway.app/*",
      "http://localhost:5174/*"
    ]
  }
}
