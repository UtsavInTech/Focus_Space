{
  "name": "focusspace",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.8.0",
  "description": "FocusSpace — an intent-driven learning layer for YouTube (Chrome extension, Manifest V3).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run icons && (vite build --mode development --watch & vite build --config vite.content.config.ts --mode development --watch & vite build --config vite.content.config.ts --mode bridge --watch)",
    "build": "npm run icons && npm run typecheck && npm run build:fast",
    "build:fast": "vite build && vite build --config vite.content.config.ts && vite build --config vite.content.config.ts --mode bridge && vite build --config vite.content.config.ts --mode site",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e/run.mjs",
    "canary": "vite-node scripts/youtube-canary.ts",
    "ai-endpoint": "node scripts/ai-endpoint/server.mjs",
    "build:server": "vite build --config vite.server.config.ts",
    "ai-api": "npm run build:server && node --env-file-if-exists=.env dist-server/index.mjs",
    "package": "node scripts/package.mjs",
    "metrics": "node scripts/metrics.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "motion": "^14.4.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
